MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=trainium

GEMINI_API_KEY=
GEMINI_MODEL_LIVE=gemini-3.5-transcribe-live
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_TTS=gemini-3.1-flash-tts-preview
GEMINI_MODEL_ANALYSIS=gemini-3.8-flash

# Share of the deck a session must get through to count as covering its
# material. Below this, Time Management is marked down.
TRAINIUM_COVERAGE_THRESHOLD=0.6

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

CORS_ORIGINS=http://localhost:3000

# Path to the LibreOffice binary used to render slides for ingestion.
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=soffice
